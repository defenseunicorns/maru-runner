{
  "enabled": true,
  "forkProcessing": "enabled",
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "ignorePaths": [],
  "timezone": "America/New_York",
  "rebaseStalePrs": true,
  "schedule": [
    "after 12pm and before 11am every weekday"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "rebaseWhen": "conflicted",
  "commitBodyTable": true,
  "suppressNotifications": [
    "prIgnoreNotification"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "vulnerabilityAlerts": {
    "groupName": "Maru Dependencies",
    "groupSlug": "maru-dependencies",
    "vulnerabilityFixStrategy": "highest",
    "commitMessageSuffix": ""
  },
  "customDatasources": {
    "zarf-go": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/zarf-dev/zarf/main/go.mod",
      "format": "plain",
      "transformTemplates": [
        "{\"releases\": [releases[$contains(version, /^go[ \\t]+[0-9]+\\.[0-9]+(\\.[0-9]+)?[ \\t\\r]*$/)].{\"version\": $trim($replace(version, /^go[ \\t]+/, \"\"))}], \"sourceUrl\": \"https://github.com/zarf-dev/zarf\"}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "action.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>.*) depName=(?<depName>.*)(versioning=(?<versioning>.*))?(registryUrl=(?<registryUrl>.*))?\\n\\s*(version|ref): (?<currentValue>.*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^go\\.mod$/"],
      "matchStrings": [
        "(?:^|\\r?\\n)go[ \\t]+(?<currentValue>[0-9]+\\.[0-9]+(?:\\.[0-9]+)?)[ \\t]*(?:\\r?\\n|$)"
      ],
      "depNameTemplate": "go",
      "datasourceTemplate": "custom.zarf-go",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "packageRules": [
    {
      "groupName": "Maru Dependencies",
      "groupSlug": "maru-dependencies",
      "separateMajorMinor": false,
      "labels": [
        "dependencies"
      ],
      "commitMessageTopic": "dependencies",
      "matchPackageNames": [
        "*"
      ]
    },
    {
      "description": "Let the custom manager follow Zarf's Go minimum instead of Go releases",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "matchPackageNames": ["go"],
      "enabled": false
    },
    {
      "matchPackageNames": ["github.com/pterm/pterm"],
      "enabled": false
    }
  ]
}
